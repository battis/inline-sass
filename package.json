{
  "name": "inline-sass",
  "version": "1.2.0",
  "description": "",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.mjs",
      "default": "./dist/esm/index.mjs"
    }
  },
  "target": "node",
  "engines": {
    "node": ">=12.17"
  },
  "author": {
    "name": "Seth Battis",
    "email": "seth@battis.net"
  },
  "license": "GPL-3.0",
  "scripts": {
    "clean": "del ./dist",
    "build": "run-s build:*",
    "build:clean": "run-s clean",
    "build:commonjs": "babel src --extensions .ts --out-dir dist/cjs --source-maps --config-file @battis/babel-config/cjs.json",
    "build:esm": "babel src --extensions .ts --out-dir dist/esm --out-file-extension .mjs --source-maps --config-file @battis/babel-config/esm.json",
    "build:types": "tsc",
    "release": "run-s release:*",
    "release:version": "commit-and-tag-version",
    "release:build": "run-s build",
    "release:publish": "pnpm publish -r --otp $(op item get npm --otp) --access public"
    },
  "dependencies": {
    "inline-css": "^4.0.3",
    "node-html-parser": "^5.4.2",
    "sass": "^1.89.2"
  },
  "devDependencies": {
    "@battis/babel-config": "^0.2.3",
    "@battis/eslint-config": "^2.0.3",
    "@battis/prettier-config": "^1.6.0",
    "@types/inline-css": "^3.0.4",
    "@types/node": "^24.0.1",
    "commit-and-tag-version": "^12.5.1",
    "del-cli": "^6.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "5.7.3"
  }
}
